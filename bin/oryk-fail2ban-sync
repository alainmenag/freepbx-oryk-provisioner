#!/usr/bin/env php
<?php
/**
 * bin/oryk-fail2ban-sync -- one run of the fail2ban sync.
 *
 * FreePBX's scheduler runs this every minute, as the web user; install()
 * registers it. Safe to run by hand: `php bin/oryk-fail2ban-sync`. It reaches
 * fail2ban only through the sudo helper -- see ARCHITECTURE.md, "Syncing with
 * fail2ban". Exits 0 when the run did its work or the sync is paused, 1 when it
 * could not.
 */

if (PHP_SAPI !== 'cli') {
	exit(1);
}

// One run at a time: a slow fail2ban must not stack the scheduler's minutes up.
$lock = @fopen(sys_get_temp_dir() . '/oryk-fail2ban-sync.lock', 'c');

if ($lock && !flock($lock, LOCK_EX | LOCK_NB)) {
	exit(0);
}

$bootstrap_settings = ['freepbx_auth' => false];
$restrict_mods = true;

require '/etc/freepbx.conf';

$result = \FreePBX::Oryk_provisioner()->syncFail2ban();

if (!empty($result['paused'])) {
	echo "paused (Settings -> Fail2ban Sync)\n";
	exit(0);
}

if (empty($result['ok'])) {
	fwrite(STDERR, 'fail2ban sync: ' . ($result['error'] ?? 'failed') . "\n");
	exit(1);
}

unset($result['ok']);

echo implode(', ', array_map(function ($what, $count) {
	return "$what $count";
}, array_keys($result), $result)), "\n";
