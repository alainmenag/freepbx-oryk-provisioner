#!/usr/bin/python3 -I
"""oryk-fail2ban -- what the Oryk Provisioner module may ask of fail2ban.

Runs as root: bin/oryk-fail2ban-setup installs a root-owned copy at
/usr/local/sbin/oryk-fail2ban and one sudo rule letting the web user run it.
**This file is the privilege boundary**, so every argument is checked here
whatever the module checked first. See ARCHITECTURE.md, "Syncing with fail2ban".

It sees only the managed jails: `banned`, `deny`, and those root lists in
CONFIG. Every other jail -- sshd above all -- it cannot read, unban in or add
an ignore entry to, so an Allow never exempts an address from them.

    oryk-fail2ban check               version; is fail2ban up; the managed jails
    oryk-fail2ban list                the managed jails' bans, with times, and ignore lists
    oryk-fail2ban ban <jail> <ip>     ban one address in `banned` or `deny`
    oryk-fail2ban unban <jail> <ip>   lift it from a managed jail; not banned is not an error
    oryk-fail2ban ignore <ip>         add to each managed jail's ignore list where missing
    oryk-fail2ban unignore <ip>       take it off each managed jail's ignore list

Every answer is one line of JSON on stdout. Exit 0 is success, 64 a refused
argument, 69 fail2ban not installed or not answering, 70 anything else.
"""

import ipaddress
import json
import os
import re
import stat
import subprocess
import sys
import time

# Bump whenever this file changes: the Bans tab and the setup script compare it
# with the installed copy.
HELPER_VERSION = 5

CLIENTS = ('/usr/bin/fail2ban-client', '/usr/local/bin/fail2ban-client', '/bin/fail2ban-client')
JAIL = re.compile(r'\A[A-Za-z0-9_.-]{1,64}\Z')
ADDRESS = re.compile(r'\A[0-9A-Fa-f:.]{2,45}\Z')
STAMP = r'(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)'
WITH_TIME = re.compile(r'\A(\S+)\s+' + STAMP + r'\s*\+\s*(-?\d+)\s*=\s*' + STAMP)
LISTED = re.compile(r'\A[|`]-\s*(\S+)\s*\Z')

# The only jails anything is banned in from here; always managed.
BANNABLE = ('banned', 'deny')

# Root's list of the other jails the module may manage: `jails = a b c`.
# Written by bin/oryk-fail2ban-setup; absent means banned and deny only.
CONFIG = '/etc/oryk-fail2ban.conf'

EX_USAGE, EX_UNAVAILABLE, EX_SOFTWARE = 64, 69, 70


class Refused(Exception):
	"""An answer that is not a success, and the exit code that says which kind."""

	def __init__(self, message, code):
		super().__init__(message)
		self.code = code


class Socket:
	"""fail2ban's own socket, through fail2ban's own client library: one process
	for every question, where fail2ban-client would start Python once per
	question. None when the library is not importable by this Python."""

	PATHS = ('/var/run/fail2ban/fail2ban.sock', '/run/fail2ban/fail2ban.sock')

	def __init__(self):
		from fail2ban.client.csocket import CSocket

		self.CSocket = CSocket
		self.connection = None

	def ask(self, args):
		if self.connection is None:
			path = next((path for path in self.PATHS if os.path.exists(path)), None)

			if path is None:
				raise Refused('fail2ban is not running (no socket)', EX_UNAVAILABLE)

			try:
				self.connection = self.CSocket(path, timeout=20)
			except OSError as error:
				raise Refused('fail2ban is not answering: ' + str(error), EX_UNAVAILABLE)

		try:
			code, value = self.connection.send(list(args))
		except OSError as error:
			raise Refused('fail2ban is not answering: ' + str(error), EX_UNAVAILABLE)

		if code != 0:
			raise Refused(' '.join(map(str, getattr(value, 'args', [value]))) or type(value).__name__, EX_SOFTWARE)

		return value


def client(args):
	"""The same question through fail2ban-client, where the library is not
	importable (a fail2ban on another Python), answered in the socket's shapes."""
	path = next((path for path in CLIENTS if os.access(path, os.X_OK)), None)

	if path is None:
		raise Refused('fail2ban-client is not installed', EX_UNAVAILABLE)

	try:
		done = subprocess.run(
			[path] + list(args),
			stdout=subprocess.PIPE,
			stderr=subprocess.PIPE,
			universal_newlines=True,
			timeout=20,
			env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C'},
		)
	except subprocess.TimeoutExpired:
		raise Refused('fail2ban did not answer in time', EX_UNAVAILABLE)

	if done.returncode != 0:
		message = (done.stderr or done.stdout).strip().splitlines()
		raise Refused(message[-1] if message else 'fail2ban-client failed', EX_SOFTWARE)

	lines = done.stdout.strip().splitlines()

	if args[0] == 'status':
		match = re.search(r'Jail list:\s*(.*)$', done.stdout, re.MULTILINE)
		return [('Jail list', match.group(1) if match else '')]

	if args[0] == 'get' and args[2] == 'ignoreip':
		return [match.group(1) for match in map(LISTED.match, map(str.strip, lines)) if match]

	if args[0] == 'get':
		return lines

	return done.stdout.strip()


TRANSPORT = []


def fail2ban(*args):
	"""Ask fail2ban one thing; the answer as fail2ban's socket gives it."""
	if not TRANSPORT:
		try:
			TRANSPORT.append(Socket().ask)
		except ImportError:
			TRANSPORT.append(client)

	return TRANSPORT[0](args)


def configured():
	"""The jails CONFIG adds to BANNABLE.

	CONFIG is what keeps sshd out of the module's reach, so a file anyone but
	root could have written is refused outright rather than read.
	"""
	try:
		fd = os.open(CONFIG, os.O_RDONLY | os.O_NOFOLLOW)
	except FileNotFoundError:
		return []
	except OSError as error:
		raise Refused('cannot read ' + CONFIG + ': ' + error.strerror, EX_SOFTWARE)

	with os.fdopen(fd) as handle:
		info = os.fstat(handle.fileno())

		if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
			raise Refused(CONFIG + ' must be a file owned by root and writable by root only', EX_SOFTWARE)

		names = []

		for line in handle:
			key, _, value = line.partition('=')

			if key.strip() == 'jails':
				names = [name for name in value.split() if JAIL.match(name)]

	return names


def jails():
	"""The managed jails fail2ban has: BANNABLE and configured(), from `status`."""
	listed = dict(fail2ban('status')).get('Jail list', '')
	managed = set(BANNABLE) | set(configured())

	return [name for name in (name.strip() for name in str(listed).split(',')) if name in managed]


def jail(name, allowed=None):
	"""A jail name that is well formed, managed, loaded, and allowed here."""
	if not JAIL.match(name) or (allowed is not None and name not in allowed) or name not in jails():
		raise Refused('no such jail here: ' + name[:64], EX_USAGE)

	return name


def address(text):
	"""One IPv4 or IPv6 address, canonical. No ranges, no zone ids, no loopback."""
	try:
		if not ADDRESS.match(text):
			raise ValueError

		ip = ipaddress.ip_address(text)
	except ValueError:
		raise Refused('not a single IP address: ' + text[:45], EX_USAGE)

	if ip.is_loopback or ip.is_unspecified:
		raise Refused('a loopback or unspecified address: ' + str(ip), EX_USAGE)

	return str(ip)


def epoch(stamp):
	"""A fail2ban timestamp -- the system's local time -- as seconds since 1970."""
	return int(time.mktime(time.strptime(stamp, '%Y-%m-%d %H:%M:%S')))


def bans(name):
	"""Every ban in one jail. Times are fail2ban's, turned into epochs here."""
	found = []

	for line in fail2ban('get', name, 'banip', '--with-time'):
		match = WITH_TIME.match(str(line).strip())

		if not match:
			continue

		ip, banned, bantime, expires = match.groups()
		bantime = int(bantime)
		permanent = bantime < 0

		found.append({
			'jail': name,
			'ip': ip,
			'banned_at': epoch(banned),
			'bantime': bantime,
			'permanent': permanent,
			'expires_at': None if permanent else epoch(expires),
		})

	return found


def ignored(name):
	"""One jail's ignore list, as fail2ban holds it (addresses, networks, names)."""
	return [str(entry) for entry in fail2ban('get', name, 'ignoreip')]


def banned_ips(name):
	"""The addresses banned in one jail, without their times."""
	return [ban['ip'] for ban in bans(name)]


def run(argv):
	"""Answer one command line."""
	verb = argv[0] if argv else ''
	args = argv[1:]

	if verb == 'check' and not args:
		answer = {'version': HELPER_VERSION}

		try:
			fail2ban('ping')
			answer['fail2ban'] = str(fail2ban('version')).strip()
			answer['jails'] = jails()
		except Refused as refused:
			print(json.dumps(dict(answer, ok=False, error=str(refused))))
			return EX_UNAVAILABLE

		return answer

	if verb == 'list' and not args:
		names = jails()

		return {
			'now': int(time.time()),
			'jails': names,
			'bans': [ban for name in names for ban in bans(name)],
			'ignore': {name: ignored(name) for name in names},
		}

	if verb == 'ban' and len(args) == 2:
		name, ip = jail(args[0], BANNABLE), address(args[1])
		fail2ban('set', name, 'banip', ip)
		return {'jail': name, 'ip': ip}

	if verb == 'unban' and len(args) == 2:
		name, ip = jail(args[0]), address(args[1])

		try:
			fail2ban('set', name, 'unbanip', ip)
		except Refused:
			# Asked to be in the state it is already in: gone.
			if ip in banned_ips(name):
				raise

		return {'jail': name, 'ip': ip}

	if verb in ('ignore', 'unignore') and len(args) == 1:
		ip = address(args[0])
		changed = []

		for name in jails():
			listed = ip in ignored(name)

			if verb == 'ignore' and not listed:
				fail2ban('set', name, 'addignoreip', ip)
				changed.append(name)
			elif verb == 'unignore' and listed:
				fail2ban('set', name, 'delignoreip', ip)
				changed.append(name)

		return {'ip': ip, 'jails': changed}

	raise Refused('usage: oryk-fail2ban check|list|ban <jail> <ip>|unban <jail> <ip>|ignore <ip>|unignore <ip>', EX_USAGE)


def main():
	try:
		answer = run(sys.argv[1:])
	except Refused as refused:
		code = refused.code

		# A command that failed because fail2ban is down says so, rather than
		# whatever fail2ban-client printed on its way out.
		if code == EX_SOFTWARE:
			try:
				fail2ban('ping')
			except Refused:
				code = EX_UNAVAILABLE

		print(json.dumps({'ok': False, 'error': str(refused)}))
		return code

	if isinstance(answer, int):
		return answer

	print(json.dumps(dict(answer, ok=True)))
	return 0


if __name__ == '__main__':
	sys.exit(main())
